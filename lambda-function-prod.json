{
  "functionName": "harness-weather-lambda-prod",
  "runtime": "python3.12",
  "handler": "app.lambda_handler",
  "memorySize": 128,
  "timeout": 15,
  "role": "arn:aws:iam::469740788063:role/harness-trg-lambda-execution",
  "environment": {
    "variables": {
      "DEFAULT_PLACE": "<+pipeline.variables.default_place>",
      "UNITS": "<+pipeline.variables.units>",
      "DEPLOY_ENV": "prod",
      "APP_VERSION": "<+pipeline.variables.artifact_version>",
      "METEOSOURCE_API_KEY": "<+secrets.getValue(\'meteosource_api_key\')>"
    }
  }
}
